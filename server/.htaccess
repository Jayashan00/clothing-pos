# Protect secrets and internals
<FilesMatch "^(config\.php|config\.sample\.php|bootstrap\.php)$">
  Require all denied
</FilesMatch>
Options -Indexes
# Large syncs (first upload of a big shop)
<IfModule mod_php.c>
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 120
</IfModule>
